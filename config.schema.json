{
  "pluginAlias": "Rituals",
  "pluginType": "accessory",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "accessory": {
        "title": "Accessory Type",
        "type": "string",
        "default": "Rituals",
        "readOnly": true
      },
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Genie",
        "required": true
      },
      "account": {
        "title": "E-mail",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "Password",
        "type": "string",
        "format": "password",
        "required": true
      },
      "battery": {
        "title": "Has Battery (original Genie 1.0 only)",
        "type": "boolean",
        "default": false
      }
    }
  }
}